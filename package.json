{
  "name": "supersophie",
  "version": "0.3.0",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern build",
    "db:generate": "drizzle-kit generate",
    "desktop:dev": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:3000 && electron desktop/main.cjs\"",
    "desktop:pack": "pnpm build && electron-builder --win"
  },
  "dependencies": {
    "@openai/agents": "^0.13.4",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.3",
    "drizzle-kit": "0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wait-on": "^9.0.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.supersophie.desktop",
    "productName": "SuperSophie",
    "electronDist": "node_modules/electron/dist",
    "beforeBuild": "desktop/before-build.cjs",
    "directories": {
      "app": "desktop",
      "output": "desktop-dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "public/sophie-companion.png",
        "to": "sophie-companion.png"
      }
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": "nsis"
    },
    "fileAssociations": [
      {
        "ext": "sophie",
        "name": "SuperSophie Page",
        "description": "SuperSophie 离线页面",
        "role": "Editor"
      }
    ]
  }
}
